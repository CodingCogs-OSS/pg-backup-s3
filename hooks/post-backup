#!/bin/sh
# run-parts hook shipped in both images (pg-backup-s3 and mongo-backup-s3).
#
# Each image's /backup.sh runs every script in /hooks with run-parts, passing the
# action as $1 ("pre-backup", "post-backup" or "error"), so this one script handles all
# three:
#
#   pre-backup   flag that a dump is being written, so a scheduled S3 sync does
#                not upload a half-written file
#   post-backup  clear that flag, then sync every destination that is configured
#                to ship right after a backup (see S3_SCHEDULE in s3-sync)
#   error        clear the flag
#
# Destinations with their own S3_SCHEDULE[_N] are skipped here; the scheduler
# started by pg-backup-s3-entrypoint syncs those on their own cadence.
#
# All S3 configuration lives in /usr/local/bin/s3-sync (run `s3-sync --help`).

set -eu

STATE_DIR="${S3_SYNC_STATE_DIR:-/tmp/pg-backup-s3}"
BACKUP_MARKER="$STATE_DIR/backup-in-progress"
S3_SYNC_BIN="${S3_SYNC_BIN:-/usr/local/bin/s3-sync}"

log() { printf '[post-backup] %s\n' "$*" >&2; }

case "${1:-post-backup}" in
  pre-backup)
    # must never fail: run-parts runs pre-backup hooks with --exit-on-error
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    date -u '+%Y-%m-%dT%H:%M:%SZ' >"$BACKUP_MARKER" 2>/dev/null || true
    exit 0
    ;;

  error)
    rm -f "$BACKUP_MARKER" 2>/dev/null || true
    exit 0
    ;;

  post-backup)
    rm -f "$BACKUP_MARKER" 2>/dev/null || true
    if [ ! -x "$S3_SYNC_BIN" ]; then
      log "$S3_SYNC_BIN is missing or not executable"
      exit 1
    fi
    exec "$S3_SYNC_BIN" --immediate
    ;;

  *)
    # unknown action: nothing to do
    exit 0
    ;;
esac
