# shellcheck shell=sh disable=SC2034
# Image versions, read by scripts/build.sh (local builds) and
# scripts/ci-matrix.sh (.github/workflows/images.yml). Space separated.
# The LAST entry of each list also gets the "latest" tag.
# Adding PostgreSQL 19 after its GA = append 19 to PG_MAJORS.
PG_MAJORS="14 15 16 17 18"
MONGO_VERSIONS="7.0 8.0 8.3 9.0"
PG_IMAGE="cc0funobit/pg-backup-s3"
MONGO_IMAGE="cc0funobit/mongo-backup-s3"
