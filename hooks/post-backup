#!/bin/sh
set -eu

: "${S3_BUCKET:?S3_BUCKET not set}"

# Mirror the local backup layout (last/daily/weekly/monthly) into S3.
# --sse encrypts at rest; backups contain PII so keep this on.
aws s3 sync "${BACKUP_DIR:-/backups}" "s3://${S3_BUCKET}/${S3_PREFIX:-pg-backups}" \
  --sse aws:kms \
  --only-show-errors
